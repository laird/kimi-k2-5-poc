# =============================================================================
# Kimi K2.5 GCP Deployment - Git Ignore
# =============================================================================

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/.terraform.lock.hcl
terraform/crash.log
terraform/crash.*.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
.env
.env.local
.env.*.local
secrets/
credentials/

# Connection info (generated files)
*-connection-info.txt
*-stop-info.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
